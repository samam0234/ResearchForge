# ==========================================
# ResearchForge Environment Configuration
# ==========================================

# --- General ---
APP_ENV=development
APP_NAME=ResearchForge

# --- PostgreSQL Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=researchforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_password

# --- Redis Cache & Queue ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Go Backend ---
BACKEND_PORT=8080
JWT_SECRET=super-secret-jwt-token-change-in-production
AI_SERVER_URL=http://ai-server:8000

# --- AI Server (FastAPI) ---
AI_SERVER_PORT=8000
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_search_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# --- Frontend (Nuxt.js) ---
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE=http://localhost:8080/api
NUXT_PUBLIC_WS_BASE=ws://localhost:8080/ws
